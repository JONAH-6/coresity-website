# Image settings for scripts/docker/*.sh. Copy to scripts/docker/.env and
# edit; the file is optional and every value below is the default.
# A variable set in your shell overrides this file, e.g.
#   IMAGE_NAMESPACE=someone-else scripts/docker/build-push.sh 1.0.0
# Only these keys are accepted.

# Registry host: docker.io (Docker Hub), ghcr.io, ...
REGISTRY=docker.io

# Account or organisation that owns the image in that registry.
IMAGE_NAMESPACE=privexlabs

# Repository name. Pushed images are REGISTRY/IMAGE_NAMESPACE/IMAGE_NAME.
IMAGE_NAME=coresity-web

# Target platform. SecretVM and typical VPSes are linux/amd64.
PLATFORM=linux/amd64

# Custom Domain set in the SecretAI portal for the SecretVM deployment.
# Used by secretvm.sh show when printing the launch and DNS steps.
SECRETVM_DOMAIN=coresity.com
