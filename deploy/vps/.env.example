# Copy to .env next to docker-compose.yml on the server and fill in.

# The image to run, pinned by tag and digest. scripts/docker/build-push.sh
# prints this exact value after a push, e.g.
#   docker.io/privexlabs/coresity-web:1.0.0@sha256:<64 hex characters>
WEB_IMAGE=

# Public hostname the site is served on. Its DNS record must point at this
# server before the first start, so Let's Encrypt can issue the certificate.
DOMAIN=coresity.example.com

# Contact address Let's Encrypt uses for expiry and account notices.
ACME_EMAIL=ops@example.com
